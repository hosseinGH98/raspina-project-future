# Raspina Digital Ecosystem - Apache Shared Hosting Configuration (.htaccess)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Protect SQL dumps and PHP config files from direct HTTP access
  RewriteRule ^sql/ - [F,L]
  RewriteRule ^api/config(\.example)?\.php$ - [F,L]

  # Allow existing files, directories, and API endpoints
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route SPA paths to index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
